{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Askk",
  "version": "0.1.0",
  "identifier": "com.kaush.askk",
  "build": {
    "beforeDevCommand": "bun run build && cargo build -p askk-server",
    "beforeBuildCommand": "bun run build && cargo build --release -p askk-server",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
