# PINS — every origin this build fetches from, pinned as hard as the origin allows.
#
# Resolved and verified on 2026-08-28. Each line is either an immutable content
# reference (git commit sha, image manifest digest, tarball sha256) or is listed
# in scripts/wasm/README-UNPINNED.md with what happens the day it disappears.

# container2wasm itself. Vendored via --assets so the build never clones it.
# NOTE: the upstream account moved; ktock/container2wasm is now a fork stub with
# zero tags, which is why c2w 0.8.4 as shipped cannot build at all.
C2W_REPO=https://github.com/container2wasm/container2wasm
C2W_SHA=6ed3d98882a2b22eafc1334f574c364a5b2b8c47          # tag v0.8.4

# Base images, by manifest digest (linux/amd64 is forced by c2w itself).
IMG_UBUNTU_2204=sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc
IMG_UBUNTU_LATEST=sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
IMG_GOLANG=sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514
IMG_RUST=sha256:698e0acd00a30c8842887c3792c5c68e1d23565cfcc11d0203dbe4eeb31213c0

# Git sources, by commit sha (upstream pins some of these by tag only).
# Annotated tags peel: `git ls-remote <repo> 'refs/tags/X'` returns the TAG OBJECT
# sha, which never equals `git rev-parse HEAD` after a clone. linux and runc are
# annotated (peeled below); tini and wasi-vfs are lightweight and need no peel.
# The first build here failed on exactly this.
SHA_LINUX=830b3c68c1fb1e9176028d02ef86f3cf76aa2476            # tag v6.1 (peeled)
SHA_RUNC=4ca628d1d4c974f92d24daccb901aa078aad748e             # tag v1.3.0 (peeled)
SHA_TINI=de40ad007797e0dcd8b7126f27bb87401d224240             # tag v0.19.0
SHA_WASI_VFS=89bec45d4171486f4f23a3fcdf2be9c64cb29486         # tag v0.3.0
SHA_VMTOUCH=af86e27675843b3c7e4ddfee66ddbaf44eff43c4          # upstream pins NOTHING here
# Already sha-pinned by upstream, repeated here so a drift is visible:
SHA_BOCHS=a88d1f687ec83ff82b5318f59dcecb8dab44fc83
SHA_WIZER=04e49c989542f2bf3a112d60fbf88a62cce2d0d0

# Tarballs, by sha256 of the bytes actually consumed.
# grub is repointed: ftp.gnu.org is unreachable from here and ftpmirror.gnu.org
# returns 502. mirrors.kernel.org serves byte-identical content (hash below).
URL_GRUB=https://mirrors.kernel.org/gnu/grub/grub-2.06.tar.gz
SHA256_GRUB=23b64b4c741569f9426ed2e3d0e6780796fca081bee4c99f62aa3f53ae803f5f
SHA256_BUSYBOX=b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314
SHA256_WASI_SDK=d900abc826eec1955b9afd250e7cc2496338abbf6c440d86a313c06e42083fa1
SHA256_BINARYEN=0a2c3c22bdb4d017f0cf2cefb3635b616c4802e6e5dc84c82fdfe4dee42fe7b7
