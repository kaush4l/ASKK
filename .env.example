# Your model connection, for running ASKK on this machine (bun run dev, askk,
# askk ask). Copy to .env and fill in; .env is git-ignored and never shipped.
# The hosted site never sees it: visitors add their own model in Settings.
#
# Any OpenAI-compatible server (/chat/completions) or the Anthropic API
# (/messages). The browser calls it directly, so it must allow this origin
# (CORS) when it is not on localhost.

ASKK_MODEL_BASE_URL=http://127.0.0.1:8080/v1
ASKK_MODEL_ID=your-model-id
ASKK_MODEL_PROVIDER=openai          # openai | anthropic | claude-cli | codex-cli | gemini-cli | apple (no URL)
# ASKK_MODEL_API_KEY=
# ASKK_MODEL_LABEL=My local model
# ASKK_MODEL_KEY=local              # its key in the catalogue
# ASKK_MODEL_MAX_TOKENS=8192
# ASKK_MODEL_CONTEXT_LENGTH=

# Optional backup: used when the model above fails before answering (a CLI
# refused, a server down). Same fields with ASKK_BACKUP_ (key default: backup).
# ASKK_BACKUP_PROVIDER=openai
# ASKK_BACKUP_BASE_URL=http://127.0.0.1:8873/v1
# ASKK_BACKUP_ID=your-local-model

# Integrations (integrations/<name>/, kept out of git), e.g. Telegram:
# Web search (web.search): a SearXNG instance with the JSON format enabled
# (free, open source: docker run -p 8888:8080 searxng/searxng). Unset: DuckDuckGo.
# ASKK_SEARXNG_URL=http://localhost:8888

# TELEGRAM_BOT_TOKEN=               # from @BotFather
# TELEGRAM_CHAT_ID=                 # your chat: replies go here; the only chat accepted
# TELEGRAM_ALLOWED_CHATS=           # optional, more chats listened to and sent to
# TELEGRAM_GROUP_CHAT_ID=           # optional, the group chat (to: "group"); send-only
# TELEGRAM_SEND_CHATS=              # optional, chats only sent to (e.g. a group)

# An MCP url server may read its bearer token from an OAuth token file
# (mcp.json: "oauth": "${MY_OAUTH_FILE}"), shared in place, never copied.
# MY_OAUTH_FILE=

# Models this Mac runs need no settings here: in Settings pick Claude CLI,
# Codex CLI, Gemini CLI or Apple on-device (local mode only). Sign in to each
# CLI once in a terminal (claude, codex, gemini); Apple: vendor/README.md.

# Team folder(s) to run instead of public/agents (custom/<team>, git-ignored).
# bun run dev, askk and askk ask use it when no --agents is given.
# ASKK_AGENTS=custom/<team>

# Autopilot: every agent tool call runs without asking (unattended scheduled
# runs). The status bar toggle overrides it and is remembered.
# ASKK_AUTOPILOT=1

# Context cap per agent in tokens (default 262144); auto-summarize runs at 92%.
# agent.md `context_window: <n>` overrides it for one agent.
# ASKK_CONTEXT_CAP=262144
