# Settings for running ASKK on this machine (bun run dev, askk, bun run send). Copy to .env and fill in; .env is
# git-ignored and never shipped. Agents can never read or write it through the host API.
#
# Models: a desk names its own (custom/<desk>/desk.config.js) and reads its keys from here under the names it
# chooses. Models this Mac runs (claude, codex, gemini CLIs; Apple on-device) need nothing here: sign in to each
# CLI once in a terminal; Apple: vendor/README.md.

# One desk to host when bun run dev / askk get no --desks (bun run send uses it when no --agents is given).
# ASKK_AGENTS=custom/<desk>
# With --desks: the desk a new tab opens (default: the first).
# ASKK_DESK=<desk>
# The always-on desks server's port (scripts/send.js --start; launchd askk.desks).
# ASKK_DESKS_PORT=1111
# The server's log file (launchd sets it; default: the default desk's state/server.log).
# ASKK_SERVER_LOG=

# Web search (GET web/search): a SearXNG instance with the JSON format enabled
# (free, open source: docker run -p 8888:8080 searxng/searxng). Unset: DuckDuckGo.
# ASKK_SEARXNG_URL=http://localhost:8888

# Integrations (integrations/<name>/, kept out of git), e.g. Telegram:
# TELEGRAM_BOT_TOKEN=               # from @BotFather
# TELEGRAM_CHAT_ID=                 # your private chat with the bot (= your user id): replies go here
# TELEGRAM_OWNER_ID=                # optional, your user id if not TELEGRAM_CHAT_ID; only your own
#                                   # private-chat messages are taken (not groups, others, forwards)
# TELEGRAM_ALLOWED_CHATS=           # optional, more chats it may send to (never listened to)
# TELEGRAM_GROUP_CHAT_ID=           # optional, the group chat (to: "group"); send-only
# TELEGRAM_SEND_CHATS=              # optional, chats only sent to (e.g. a group)

# An MCP url server may read its bearer token from an OAuth token file
# (mcp.json: "oauth": "${MY_OAUTH_FILE}"), shared in place, never copied.
# MY_OAUTH_FILE=

# Hardware: speech on this Mac (on-device recognition + voices, page /sts). "off" turns it off.
# ASKK_SPEECH=off
