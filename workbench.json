{
  "version": 1,
  "defaultExecution": "browser",
  "executionNotices": {
    "browser": {
      "title": "Browser Linux preview",
      "body": "Browser Linux is experimental. App builds are not ready for reliable use yet. Startup can take several minutes."
    }
  },
  "acceptance": {
    "requireArtifact": true,
    "requireInteraction": true
  },
  "template": {
    "framework": "next",
    "language": "javascript",
    "output": "export",
    "previewProfile": "single-page",
    "dependencies": {
      "next": "16.3.6",
      "react": "19.3.0",
      "react-dom": "19.3.0"
    },
    "buildScript": "next build --webpack",
    "install": {
      "browser": "npm install --offline --no-audit --no-fund",
      "local": "bun install"
    },
    "nextConfig": {
      "output": "export",
      "images": {
        "unoptimized": true
      },
      "experimental": {
        "cpus": 1
      }
    }
  },
  "defaultWorkflow": "assistant",
  "workflows": [
    {
      "id": "assistant",
      "label": "General assistant",
      "description": "Research, plan, reason, and coordinate agents without starting a workspace runtime.",
      "agent": "bundled/starter/assistant",
      "workspace": false,
      "strategy": "strategies/conversation.json"
    },
    {
      "id": "parallel-review",
      "label": "Compare perspectives",
      "description": "Run an approach and critique in parallel, then combine their findings.",
      "agent": "bundled/starter/synthesizer",
      "workspace": false,
      "strategy": "strategies/parallel-review.json"
    },
    {
      "id": "coding",
      "label": "Build an app",
      "description": "Create files, run commands, and verify an application in the selected workspace.",
      "agent": "bundled/starter/main",
      "workspace": true,
      "strategy": "strategies/coding.json"
    }
  ],
  "toolPolicy": {
    "disabledTools": [],
    "approvalRisks": [],
    "allowDelegation": true
  }
}
