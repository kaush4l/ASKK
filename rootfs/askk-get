#!/bin/sh
# askk-get <name> [dest] — pull a binary from the page's docs/bin/ folder
# into the running guest over the fetch-proxy network.
# Source: $ASKK_BIN_URL (default http://bin.askk.internal — SW sentinel host).
#
# Multi-part artifacts (CONTRACTS.md): an artifact over the shelf size cap
# ships as <name>.part-aa, <name>.part-ab, ... plus a <name>.parts index —
# plain text, one part basename per line, in concatenation order. askk-get
# probes <name>.parts first; 404 means a plain single-file artifact.

# Overridable for tests only; real boot uses the defaults.
ENV_FILE="${ASKK_ENV_FILE:-/etc/askk/env}"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"
BIN_URL="${ASKK_BIN_URL:-http://bin.askk.internal}"

if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ]; then
    echo "usage: askk-get <name> [dest]" >&2
    echo "  binary:  fetches $BIN_URL/<name> to [dest] (default /usr/local/bin/<name>), chmod +x" >&2
    echo "  tarball: <name> ending .tar.gz/.tgz is extracted into [dest] (default /opt)" >&2
    exit 2
fi

name=$1

# retry <fn>: up to 3 attempts, short pause between. In tarball mode a retry
# re-runs the whole wget|tar pipeline (tar cannot resume a stream): attempt
# N+1 re-extracts the same files over attempt N's partial output, so the end
# state is whole.
retry() {
    _try=0
    until "$@"; do
        _try=$((_try + 1))
        [ "$_try" -gt 2 ] && return 1
        sleep 2
    done
}

# Probe the multi-part index. Single attempt on purpose: for most artifacts
# 404 is the expected answer, and a transient miss just falls back to the
# single-file path (which does retry).
parts=$(wget -q -O - -T 15 "$BIN_URL/$name.parts" 2>/dev/null) || parts=""

# Stream the artifact's bytes to stdout — concatenated parts or single file.
emit() {
    if [ -n "$parts" ]; then
        for p in $parts; do
            wget -O - -T 15 "$BIN_URL/$p" || return 1
        done
    else
        wget -O - -T 15 "$BIN_URL/$name"
    fi
}

case "$name" in
*.tar.gz|*.tgz)
    # Tarball mode (ADR-048 bundles): stream-extract — a 100MB+ bundle would
    # not fit twice in the RAM-backed rootfs. A truncated stream fails the
    # gzip integrity check, so the pipeline's exit status is trustworthy.
    dest="${2:-/opt}"
    mkdir -p "$dest"
    extract() { emit | tar -xzf - -C "$dest"; }
    if ! retry extract; then
        echo "askk-get: fetch/extract failed: $BIN_URL/$name" >&2
        exit 1
    fi
    echo "askk-get: extracted $name into $dest"
    exit 0
    ;;
esac

dest="${2:-/usr/local/bin/$name}"
tmp="$dest.part"

# Download to .part then move: never clobber a working binary with a
# truncated download. The > truncates per attempt, so a retry starts clean.
grab() { emit > "$tmp"; }
if ! retry grab; then
    rm -f "$tmp"
    echo "askk-get: download failed: $BIN_URL/$name" >&2
    exit 1
fi
if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "askk-get: empty download: $BIN_URL/$name" >&2
    exit 1
fi
chmod 755 "$tmp" && mv "$tmp" "$dest" || { rm -f "$tmp"; exit 1; }
echo "askk-get: installed $dest"
