[
  {
    "name": "openai",
    "base_url": "https://api.openai.com/v1",
    "path": "/chat/completions",
    "auth": "bearer",
    "body": {
      "model": "{model}",
      "messages": [
        {
          "role": "user",
          "content": "{prompt}"
        }
      ],
      "max_completion_tokens": "{max_tokens}"
    },
    "reply": [
      "/choices/0/message/content"
    ],
    "models": "/models",
    "context": [
      "/context_window"
    ]
  },
  {
    "name": "openai-responses",
    "base_url": "https://api.openai.com/v1",
    "path": "/responses",
    "auth": "bearer",
    "body": {
      "model": "{model}",
      "input": "{prompt}",
      "max_output_tokens": "{max_tokens}"
    },
    "reply": [
      "/output_text",
      "/output/0/content/0/text",
      "/output/1/content/0/text"
    ],
    "models": "/models",
    "context": [
      "/context_window"
    ]
  },
  {
    "name": "anthropic",
    "base_url": "https://api.anthropic.com",
    "path": "/v1/messages",
    "auth": "x-api-key",
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "body": {
      "model": "{model}",
      "max_tokens": "{max_tokens}",
      "messages": [
        {
          "role": "user",
          "content": "{prompt}"
        }
      ]
    },
    "reply": [
      "/content/0/text"
    ],
    "models": "/v1/models",
    "context": [
      "/max_input_tokens"
    ]
  },
  {
    "name": "omlx",
    "base_url": "http://127.0.0.1:8000/v1",
    "path": "/chat/completions",
    "auth": "bearer",
    "body": {
      "model": "{model}",
      "messages": [
        {
          "role": "user",
          "content": "{prompt}"
        }
      ],
      "max_tokens": "{max_tokens}"
    },
    "reply": [
      "/choices/0/message/content"
    ],
    "models": "/models",
    "context": [
      "/max_model_len",
      "/context_length",
      "/max_context_length"
    ]
  }
]