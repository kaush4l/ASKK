{
  "default": "claude",
  "models": [
    {
      "name": "claude",
      "connector": "cli",
      "command": [
        "claude",
        "-p",
        "{prompt}"
      ],
      "context": 200000,
      "max_tokens": 32000
    },
    {
      "name": "claude-sonnet-5-5",
      "connector": "cli",
      "command": [
        "claude",
        "-p",
        "{prompt}",
        "--model",
        "{model}"
      ],
      "context": 200000,
      "max_tokens": 32000
    },
    {
      "name": "echo",
      "connector": "echo",
      "max_tokens": 32000
    }
  ]
}