# build output (regenerable)
node_modules/
.next/
out/
*.tsbuildinfo

# local env & secrets (NEVER publish)
.env
.env.*
!.env.example
*.key
*.pem

# os / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# tool caches
.gstack/
.cache/
.tmp/
coverage/

# generated from agents/*/agent.md by scripts/agents.js
src/agents/catalogue.generated.js

# published from agents/ by scripts/agents.js
public/agents/

# The sandbox guest image: ~100MB, built by scripts/wasm/build.sh, never committed.
public/sandbox/*.wasm
