# build output (regenerable)
node_modules/
.next/
out/
*.tsbuildinfo

# What `scripts/deploy.js` writes: the directory a static host serves. Built
# from a clean checkout of a commit, so it is a FUNCTION of the history and
# never a source of it — committing it would put the same bytes in the tree
# twice and make the second copy the one that rots.
dist/

# local env & secrets (NEVER publish)
.env
.env.*
!.env.example
*.key
*.pem

# os / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# tool caches
.gstack/
.cache/
.tmp/
coverage/

# generated from agents/*/agent.md by scripts/agents.js
src/agents/catalogue.generated.js

# published from agents/ by scripts/agents.js
public/agents/

# The RAW guest image, built by `scripts/wasm/build.sh`. Never committed, and it
# cannot be: it is over GitHub's 100 MiB per-file block and the block is on the
# file at rest. What the page loads and what the deploy carries is
# `public/sandbox/sandbox.wasm.gz`, under the block — deliberately NOT matched by
# the rule below, TRACKED on purpose, with `docs/DEPLOY.md` §1 as the argument
# for ~38 MiB of permanent history per rebuilt guest. `docs/GATE.md` holds the
# sizes, because a measurement copied into a comment becomes a confident lie the
# next time the guest is rebuilt. The raw module stays on a developer's disk for
# the probes; `vm-worker.js` inflates the compressed one with
# `DecompressionStream`.
#
# It also must not reach the export. `next build` copies `public/` WHOLE, so a
# build run in a tree that has the raw module produces an `out/` carrying a file
# the host refuses — which is why `scripts/deploy.js` builds from `git archive`
# and refuses any output file over the block.
public/sandbox/*.wasm

# One temp workspace per bench run, seeded from a task's fixtures and thrown
# away by the next one. `bench/transcripts/` and `bench/results.json` are NOT
# here: they are the evidence a run produces, and evidence that is not in the
# repository is what `CAPABILITIES.md` refuses to accept.
bench/work/

# The A/B key. `bench/blind/<task>/{A,B}.md` are the artifact a blind judge
# reads and they ARE committed; the file that says which letter is which must
# not travel beside them. It used to be written to `bench/blind/key.json` —
# INSIDE the directory a judge is handed, which is a label rather than a key —
# and now sits one level up. Regenerate it with `bun run bench:blind`.
bench/blind-key.json
