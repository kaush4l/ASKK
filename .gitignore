# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/
/companion/server/assets.gen.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MCP servers (may hold tokens); see mcp.example.json
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Vendor applications, integrations and custom agent teams: local only, never pushed
/vendor/
/integrations/
/custom/
# Every desk's memory and reports (memory/<desk>/, its loaded projects in projects.json): local only, never pushed
/memory/
# The agents' files in a project they work on (.agents/ ignores itself there too)
.agents/

# Local editor settings (.vscode/settings.json hides custom/'s own git repo from Source Control)
/.vscode/

# The team shared space (agents' shared/ folder in the workspace): local only, never pushed
/shared/
.claude/settings.local.json
/docs/teams-plan.md
/.next-desks/

# Local Claude Code loop state
.claude/*.local.md

# the core desks (desks/): what they write at run time stays local
/desks/*/data/
/desks/*/state/
/desks/*/proposed/
/desks/**/transcript.jsonl
/desks/**/history/
# a core desk's kept helpers (agents/<lead>/<helper>/: keep: desk, written at run time) are local too
/desks/agent/agents/agent/*/
