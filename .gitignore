# build output (regenerable: `bun run build`)
dist/
.next/
out/
public/runtime/modules/
node_modules/

# The listing is generated: by scripts/serve.js per request, by scripts/build.js into dist/.
# public/agents/ itself IS source — the agent folders the page loads.
public/agents/index.json

# local env & secrets (NEVER publish)
.env
.env.*
!.env.example
*.key
*.pem

# os / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# tool caches (.cache/ also keeps the old tree's 143 MB guest image, off the published path)
.gstack/
.cache/
.tmp/
coverage/

# Retain the Python source archive, not interpreter-generated caches.
__pycache__/
*.pyc
