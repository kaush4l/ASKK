{
  "name": "harness",
  "private": true,
  "type": "module",
  "description": "Folder agents, one browser thread each, any model; a static page with an optional host bridge.",
  "scripts": {
    "dev": "bun scripts/prepare-app.js && bun --bun next dev --webpack --port 5187",
    "build": "bun scripts/prepare-app.js && bun --bun next build --webpack",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/ASKK bun run build",
    "serve": "bun scripts/serve-export.js",
    "dev:legacy": "bun scripts/serve.js",
    "build:legacy": "bun scripts/build.js",
    "bridge": "bun host/bridge.js",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "next": "16.3.6",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
