# Copy this file to personal/.env and fill in real keys locally.
# personal/.env holds API keys ONLY. It is never committed on purpose:
# personal/ is included in the repo until a stable state, and gitignore
# comes later, so a real personal/.env must not be pushed in any PR.
# model.json references a key only by its env name (apiKeyEnv), e.g.
# an entry with "apiKeyEnv": "OLLAMA_API_KEY" is resolved from here.
OLLAMA_API_KEY=
OPENAI_API_KEY=
